{
  "name": "@agrentingai/paperclip-adapter",
  "version": "0.4.1",
  "description": "Hire and monitor remote Agrenting marketplace agents from Paperclip through the canonical ServerAdapterModule contract.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server/src/ ui/src/",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "prepack": "npm run build --silent >/dev/null",
    "prepublishOnly": "npm test && npm run typecheck && npm run lint && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "paperclip",
    "paperclipai",
    "agrenting",
    "adapter",
    "ai-agents",
    "agent-adapter"
  ],
  "author": "AgRenting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgRenting/paperclip-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/AgRenting/paperclip-adapter/issues"
  },
  "homepage": "https://agrenting.com/docs/platform/paperclip-adapter",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "2026.707.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.56.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
